<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_trucking" model="ir.module.category">
        <field name="name">Trucking</field>
        <field name="sequence">20</field>
    </record>

    <!-- Main Dropdown -->
    <record id="res_groups_privilege_trucking" model="res.groups.privilege">
        <field name="name">Trucking Roles</field>
        <field name="category_id" ref="module_category_trucking"/>
    </record>

    <record id="group_trucking_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_trucking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('analytic.group_analytic_accounting'))]"/>
    </record>

    <record id="group_trucking_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_trucking"/>
        <field name="implied_ids" eval="[(4, ref('group_trucking_user'))]"/>
    </record>

    <!-- Fuel Approver Checkbox -->
    <record id="res_groups_privilege_fuel_approver" model="res.groups.privilege">
        <field name="name">Fuel Approver</field>
        <field name="category_id" ref="module_category_trucking"/>
    </record>
    <record id="group_trucking_fuel_approver" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="res_groups_privilege_fuel_approver"/>
    </record>

    <!-- Deposit Approver Checkbox -->
    <record id="res_groups_privilege_deposit_approver" model="res.groups.privilege">
        <field name="name">Deposit Approver</field>
        <field name="category_id" ref="module_category_trucking"/>
    </record>
    <record id="group_trucking_deposit_approver" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="res_groups_privilege_deposit_approver"/>
    </record>

    <!-- Transporter Creator Checkbox -->
    <record id="res_groups_privilege_transporter_creator" model="res.groups.privilege">
        <field name="name">Transporter Creator</field>
        <field name="category_id" ref="module_category_trucking"/>
    </record>
    <record id="group_trucking_transporter_creator" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="res_groups_privilege_transporter_creator"/>
        <field name="implied_ids" eval="[(4, ref('group_trucking_user'))]"/>
    </record>

    <!-- Issue Fuel Checkbox -->
    <record id="res_groups_privilege_issue_fuel" model="res.groups.privilege">
        <field name="name">Issue Fuel</field>
        <field name="category_id" ref="module_category_trucking"/>
    </record>
    <record id="group_trucking_issue_fuel" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="res_groups_privilege_issue_fuel"/>
        <field name="implied_ids" eval="[(4, ref('group_trucking_user'))]"/>
    </record>

    <!-- Reverse Fuel Checkbox -->
    <record id="res_groups_privilege_reverse_fuel" model="res.groups.privilege">
        <field name="name">Reverse Fuel</field>
        <field name="category_id" ref="module_category_trucking"/>
    </record>
    <record id="group_trucking_reverse_fuel" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="res_groups_privilege_reverse_fuel"/>
        <field name="implied_ids" eval="[(4, ref('group_trucking_user'))]"/>
    </record>

    <!-- Demurrage Approver Checkbox -->
    <record id="res_groups_privilege_demurrage_approver" model="res.groups.privilege">
        <field name="name">Demurrage Approver</field>
        <field name="category_id" ref="module_category_trucking"/>
    </record>
    <record id="group_trucking_demurrage_approver" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="res_groups_privilege_demurrage_approver"/>
    </record>

    <!-- Penalty Approver Checkbox -->
    <record id="res_groups_privilege_penalty_approver" model="res.groups.privilege">
        <field name="name">Penalty Approver</field>
        <field name="category_id" ref="module_category_trucking"/>
    </record>
    <record id="group_trucking_penalty_approver" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="res_groups_privilege_penalty_approver"/>
    </record>
</odoo>
