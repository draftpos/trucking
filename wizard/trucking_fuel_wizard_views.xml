<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucking_fuel_wizard_form" model="ir.ui.view">
        <field name="name">trucking.fuel.wizard.form</field>
        <field name="model">trucking.fuel.wizard</field>
        <field name="arch" type="xml">
            <form string="Issue Fuel">
                <field name="has_issued_fuel" invisible="1"/>
                <div class="alert alert-warning text-center" role="alert" invisible="not has_issued_fuel">
                    <strong>Warning!</strong> Fuel has already been issued for this load. Are you sure you want to issue another fuel?
                </div>
                <sheet>
                    <group>
                        <field name="load_id" invisible="1"/>
                        <field name="qty"/>
                        <field name="cost_price"/>
                        <field name="total_cost"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trucking_fuel_wizard" model="ir.actions.act_window">
        <field name="name">Issue Fuel</field>
        <field name="res_model">trucking.fuel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_load_id': active_id}</field>
    </record>
</odoo>
