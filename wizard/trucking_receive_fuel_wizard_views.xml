<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucking_receive_fuel_wizard_form" model="ir.ui.view">
        <field name="name">trucking.receive.fuel.wizard.form</field>
        <field name="model">trucking.receive.fuel.wizard</field>
        <field name="arch" type="xml">
            <form string="Receive Fuel">
                <group>
                    <field name="load_id" readonly="1" />
                    <field name="qty" required="1" />
                    <field name="cost_price" required="1" />
                    <field name="currency_id" invisible="1" />
                    <field name="amount" readonly="1" widget="monetary" force_save="1" />
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trucking_receive_fuel_wizard" model="ir.actions.act_window">
        <field name="name">Receive Fuel</field>
        <field name="res_model">trucking.receive.fuel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
