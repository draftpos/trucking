<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucking_zero_confirm_wizard_form" model="ir.ui.view">
        <field name="name">trucking.zero.confirm.wizard.form</field>
        <field name="model">trucking.zero.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Request">
                <sheet>
                    <field name="message" nolabel="1" readonly="1" class="text-danger fw-bold fs-5"/>
                    <field name="load_id" invisible="1"/>
                    <field name="request_type" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Yes, I am sure" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
