<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucking_reject_wizard_form" model="ir.ui.view">
        <field name="name">trucking.reject.wizard.form</field>
        <field name="model">trucking.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Provide Reject Reason">
                <sheet>
                    <group>
                        <field name="reason" placeholder="Enter reason for rejection..."/>
                        <field name="load_id" invisible="1"/>
                        <field name="reject_type" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
