<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Trucking Load -->
        <record id="seq_trucking_load" model="ir.sequence">
            <field name="name">Trucking Load Sequence</field>
            <field name="code">trucking.load</field>
            <field name="prefix">ST</field>
            <field name="padding">2</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Trucking Load Charge -->
        <record id="seq_trucking_load_charge" model="ir.sequence">
            <field name="name">Trucking Load Charge Sequence</field>
            <field name="code">trucking.load.charge.seq</field>
            <field name="prefix">CHG</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Default Service Product for Trucking -->
        <record id="product_trucking_service" model="product.product">
            <field name="name">Trucking</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="description_sale">Trucking and freight services.</field>
        </record>

        <!-- Default Service Product for Demurrage -->
        <record id="product_trucking_demurrage" model="product.product">
            <field name="name">Demurrage</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="description_sale">Demurrage charges.</field>
        </record>

        <!-- Default Service Product for Penalties -->
        <record id="product_trucking_penalty" model="product.product">
            <field name="name">Penalty</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="description_sale">Penalty charges.</field>
        </record>

        <!-- Cron Job for Overdue Loads -->
        <record id="ir_cron_check_overdue_loads" model="ir.cron">
            <field name="name">Trucking: Check Overdue Loads</field>
            <field name="model_id" ref="model_trucking_load"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue_loads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Job for Upcoming Loads -->
        <record id="ir_cron_check_upcoming_loads" model="ir.cron">
            <field name="name">Trucking: Check Upcoming Loads</field>
            <field name="model_id" ref="model_trucking_load"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_upcoming_loads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    
    <data noupdate="0">
        <!-- Automatically initialize mandatory fields for all companies during module upgrade -->
        <function model="res.company" name="_init_default_mandatory_fields_all"/>
    </data>
</odoo>
