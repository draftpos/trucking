<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
    <record id="view_trucking_route_tree" model="ir.ui.view">
        <field name="name">trucking.route.tree</field>
        <field name="model">trucking.route</field>
        <field name="arch" type="xml">
            <list string="Routes" editable="bottom">
                <field name="source" optional="show" />
                <field name="destination" optional="show" />
                <field name="name" readonly="1" optional="show" />
                <field name="distance" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_trucking_route_form" model="ir.ui.view">
        <field name="name">trucking.route.form</field>
        <field name="model">trucking.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <group>
                        <group>
                            <field name="source" />
                            <field name="destination" />
                            <field name="name" readonly="1" />
                            <field name="distance" />
                            <field name="is_cross_border" />
                        </group>
                    </group>
                    <notebook invisible="not is_cross_border">
                        <page string="Borders" name="borders">
                            <field name="border_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" optional="show" />
                                    <field name="border_id" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trucking_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">trucking.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>