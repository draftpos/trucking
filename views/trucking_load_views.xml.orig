<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_trucking_load_tree" model="ir.ui.view">
        <field name="name">trucking.load.tree</field>
        <field name="model">trucking.load</field>
        <field name="arch" type="xml">
            <list string="Loads" default_order="id desc">
                <field name="name" optional="show" />
                <field name="transporter_display" optional="show" />
                <field name="customer_id" optional="show" />
                <field name="product_id" string="Cargo" optional="show" />
                <field name="route_id" optional="show" />
                <field name="transporter_balance_display" optional="show" />
                <field name="pod" optional="show" />
                <field name="customer_balance" optional="show" />
                <field name="gross_profit" optional="show" />
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'upcoming'" decoration-warning="state == 'in_progress'" decoration-success="state in ('delivered', 'invoiced')" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_trucking_load_form" model="ir.ui.view">
        <field name="name">trucking.load.form</field>
        <field name="model">trucking.load</field>
        <field name="arch" type="xml">
            <form string="Load">
                <header>
                    <button name="action_request_fuel_approval" string="Request Fuel Approval" type="object" class="oe_highlight" invisible="state not in ('draft', 'pending_approval', 'rejected', 'in_progress', 'upcoming') or fuel_approval_state not in ('none', 'rejected') or transporter_type == 'in_house'" />
                    <button name="action_approve_fuel" string="Approve Fuel" type="object" class="btn-success" invisible="fuel_approval_state != 'requested' or transporter_type == 'in_house'" groups="trucking.group_trucking_fuel_approver" />
                    <button name="action_reject_fuel" string="Reject Fuel" type="object" class="btn-danger" invisible="fuel_approval_state != 'requested' or transporter_type == 'in_house'" groups="trucking.group_trucking_fuel_approver" />

                    <button name="action_request_deposit_approval" string="Request Deposit Approval" type="object" class="oe_highlight" invisible="state not in ('draft', 'pending_approval', 'rejected', 'in_progress', 'upcoming') or deposit_approval_state not in ('none', 'rejected') or transporter_type == 'in_house'" />
                    <button name="action_approve_deposit" string="Approve Deposit" type="object" class="btn-success" invisible="deposit_approval_state != 'requested' or transporter_type == 'in_house'" groups="trucking.group_trucking_deposit_approver" />
                    <button name="action_reject_deposit" string="Reject Deposit" type="object" class="btn-danger" invisible="deposit_approval_state != 'requested' or transporter_type == 'in_house'" groups="trucking.group_trucking_deposit_approver" />

                    <button name="action_deliver" string="Deliver" type="object" class="btn-success" invisible="state not in ('in_progress', 'overdue')" />
                    <button name="action_confirm_load" string="Confirm Load" type="object" class="oe_highlight" invisible="state != 'draft'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,upcoming,in_progress,delivered,invoiced" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            Order No: <field name="name" readonly="1" class="oe_inline" />
                        </h1>
                    </div>
                    <widget name="web_ribbon" title="DELAYED LOADING" bg_color="text-bg-danger" invisible="not is_delayed_loading" />

                    <group>
                        <group>
                            <field name="transporter_type" widget="radio" options="{'horizontal': true}" />
                            <field name="is_walk_in" invisible="transporter_type != 'in_house'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Load" name="load">
                            <div class="row mt-3" invisible="transporter_type == 'in_house'">
                                
                                <div class="col-md-3" style="border: 1px solid #ccc; padding: 10px;">
                                    <h4 class="text-primary mb-3">Loading Details</h4>
                                    <group>
                                        <field name="is_delayed_loading" invisible="1" />
                                        <field name="booking_date" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="expected_loading_date" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="date_loaded" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="expected_delivery_date" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="customer_id" domain="[('is_customer', '=', True)]" context="{'default_is_customer': True, 'default_is_supplier': False}" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="transporter_id" domain="[('is_supplier', '=', True), ('is_blacklisted_transporter', '=', False)]" context="{'default_is_supplier': True, 'default_is_customer': False, 'res_partner_search_mode': 'supplier'}" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="vehicle_id" required="state != 'draft'" context="{'default_partner_id': transporter_id, 'form_view_ref': 'trucking.view_trucking_vehicle_form'}" options="{'no_quick_create': True}" readonly="state in ('in_progress', 'delivered', 'invoiced')" domain="[('partner_id', '=', transporter_id)]" />
                                        <field name="trailer_1_id" required="state != 'draft'" context="{'default_partner_id': transporter_id, 'form_view_ref': 'trucking.view_trucking_trailer_form'}" options="{'no_quick_create': True}" readonly="state in ('in_progress', 'delivered', 'invoiced')" domain="[('partner_id', '=', transporter_id)]" />
                                        <field name="trailer_2_id" context="{'default_partner_id': transporter_id, 'form_view_ref': 'trucking.view_trucking_trailer_form'}" options="{'no_quick_create': True}" readonly="state in ('in_progress', 'delivered', 'invoiced')" domain="[('partner_id', '=', transporter_id)]" />
                                        <field name="qty_tonnes" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="rate_per_tonne" widget="monetary" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="total_per_load" widget="monetary" />
                                        <field name="product_id" string="Cargo" readonly="state in ('in_progress', 'delivered', 'invoiced')" context="{'default_type': 'service', 'default_description_sale': 'Trucking and freight services.'}" />
                                        <field name="currency_id" invisible="1" />
                                        <field name="company_id" invisible="1" />
                                    </group>
                                </div>
                                
                                
                                <div class="col-md-3" style="border: 1px solid #ccc; padding: 10px; border-left: none;">
                                    <h4 class="text-primary mb-3">Payment Details</h4>
                                    <group>
                                        <field name="deposit_amount" widget="monetary" readonly="deposit_approval_state in ('requested', 'approved')" />
                                        <field name="deposit_approval_state" widget="badge" decoration-info="deposit_approval_state == 'requested'" decoration-success="deposit_approval_state == 'approved'" decoration-danger="deposit_approval_state == 'rejected'" invisible="deposit_approval_state == 'none'" />
                                        <field name="deposit_reject_reason" invisible="deposit_approval_state != 'rejected'" />
                                        <field name="deposit_payment_id" invisible="not deposit_payment_id" />
                                        
                                        <field name="fuel_litres" readonly="fuel_approval_state in ('requested', 'approved')" />
                                        <field name="fuel_unit_price" readonly="fuel_approval_state in ('requested', 'approved')" />
                                        <field name="fuel_amount" widget="monetary" />
                                        <field name="fuel_approval_state" widget="badge" decoration-info="fuel_approval_state == 'requested'" decoration-success="fuel_approval_state == 'approved'" decoration-danger="fuel_approval_state == 'rejected'" invisible="fuel_approval_state == 'none'" />
                                        <field name="fuel_reject_reason" invisible="fuel_approval_state != 'rejected'" />
                                        <field name="fuel_payment_id" invisible="not fuel_payment_id" />

                                        <field name="balance" widget="monetary" />
                                        <field name="journal_id" required="state == 'pending_approval'" />
                                    </group>
                                </div>
                                
                                
                                <div class="col-md-3" style="border: 1px solid #ccc; padding: 10px; border-left: none;">
                                    <h4 class="text-primary mb-3">Delivery Info</h4>
                                    <group>
                                        <field name="delivery_date" />
                                        <field name="pod" />
                                        <field name="delivered_qty" />
                                        <field name="variance_qty" />
                                        <field name="variance_value" widget="monetary" />
                                        <field name="shortages" widget="monetary" />
                                        <field name="transporter_balance" widget="monetary" style="font-weight: bold;" />
                                        <field name="transporter_bill_id" />
                                    </group>
                                </div>
                                
                                
                                <div class="col-md-3" style="border: 1px solid #ccc; padding: 10px; border-left: none;">
                                    <h4 class="text-primary mb-3">Customer Recovery Details</h4>
                                    <group>
                                        <field name="invoice_id" />
                                        <field name="invoiced_amount" widget="monetary" />
                                        <field name="paid" widget="monetary" />
                                        <field name="customer_rate" widget="monetary" readonly="state in ('in_progress', 'delivered', 'invoiced')" />
                                        <field name="customer_balance" widget="monetary" />
                                        <field name="gross_profit" widget="monetary" style="font-weight: bold;" />
                                    </group>
                                </div>
                            </div>

                            
                            <div class="mt-4 p-3 bg-light" style="border-radius: 5px;" invisible="transporter_type == 'in_house'">
                                <h4 class="text-info">Billing Policy</h4>
                                <group col="4">
                                    <field name="bill_customer_qty" widget="radio" options="{'horizontal': true}" />
                                    <field name="bill_transporter_qty" widget="radio" options="{'horizontal': true}" />
                                </group>
                            </div>

                            
                            <div class="row mt-3" invisible="transporter_type == 'external'">
                                <div class="col-md-4" style="border: 1px solid #ccc; padding: 10px;">
                                    <h4 class="text-primary mb-3">Route &amp; Dates</h4>
                                    <group>
                                        <field name="route_id" options="{'no_quick_create': True}" />
                                        <field name="booking_date" />
                                        <field name="expected_delivery_date" />
                                        <field name="expected_loading_date" />
                                        <field name="date_loaded" />
                                        <field name="delivery_date" string="Date Delivered" />
                                        <field name="pod" />
                                    </group>
                                </div>
                                <div class="col-md-4" style="border: 1px solid #ccc; padding: 10px; border-left: none;">
                                    <h4 class="text-primary mb-3">Asset Details</h4>
                                    <group>
                                        <field name="vehicle_id" domain="[('ownership_type', '=', 'company')]" context="{'default_ownership_type': 'company'}" />
                                        <field name="trailer_1_id" domain="[('ownership_type', '=', 'company')]" context="{'default_ownership_type': 'company'}" />
                                        <field name="trailer_2_id" domain="[('ownership_type', '=', 'company')]" context="{'default_ownership_type': 'company'}" />
                                        <field name="driver_id" />
                                        <button name="%(action_trucking_fuel_wizard)d" type="action" string="Issue Fuel" class="btn-secondary mt-2" context="{'default_load_id': id}" groups="trucking.group_trucking_issue_fuel" />
                                        <div invisible="not has_issued_fuel" colspan="2" class="alert alert-info mt-2" role="alert" style="padding: 10px;">
                                            <field name="fuel_issue_logs" nolabel="1" readonly="1"/>
                                        </div>
                                    </group>
                                </div>
                                <div class="col-md-4" style="border: 1px solid #ccc; padding: 10px; border-left: none;">
                                    <h4 class="text-primary mb-3">Customer Invoice</h4>
                                    <group>
                                        <field name="customer_id" domain="[('is_customer', '=', True)]" context="{'default_is_customer': True, 'default_is_supplier': False}" />
                                        <field name="customer_rate" string="Rate" />
                                        <field name="qty_tonnes" string="Qty" />
                                        <field name="invoiced_amount" string="Total per load" />
                                        <field name="invoice_id" string="Invoice No" />
                                        <field name="pod_confirmed" />
                                        <field name="customer_balance" string="Balance" />
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Expenses" name="expenses">
                            <field name="expense_ids" readonly="state in ('delivered', 'invoiced')">
                                <list editable="bottom">
                                    <field name="date" optional="show" />
                                    <field name="account_id" optional="show" />
                                    <field name="supplier_id" optional="show" />
                                    <field name="amount" sum="Total" optional="show" />
                                    <field name="doc_no" optional="show" />
                                    <field name="journal_id" optional="show" />
                                    <field name="state" optional="show" />
                                </list>
                            </field>
                        </page>
                        <page string="Route &amp; Borders" name="route_borders">
                            <group>
                                <group>
                                    <field name="route_id" readonly="state in ('in_progress', 'delivered', 'invoiced')" options="{'no_quick_create': True}" />
                                    <field name="is_cross_border_route" invisible="1" />
                                </group>
                            </group>
                            <field name="border_tracking_ids" invisible="not is_cross_border_route" mode="list">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle" optional="show" />
                                    <field name="border_id" optional="show" />
                                    <field name="eta" optional="show" />
                                    <field name="ata" optional="show" />
                                    <field name="arrival_status" decoration-danger="'Delayed' in arrival_status" decoration-success="'On Time' in arrival_status" optional="show" />
                                    <field name="etd" optional="show" />
                                    <field name="atd" optional="show" />
                                    <field name="departure_status" decoration-danger="'Delayed' in departure_status" decoration-success="'On Time' in departure_status" optional="show" />
                                </list>
                            </field>
                        </page>
                        <page string="Tracking" name="tracking" invisible="not is_cross_border_route">
                            <field name="tracking_progress_html" widget="html" readonly="1" nolabel="1" />
                        </page>
                    </notebook>


                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trucking_load" model="ir.actions.act_window">
        <field name="name">Loads</field>
        <field name="res_model">trucking.load</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Server Action to Print/Create Invoice from List view -->
    <record id="action_trucking_load_create_invoice" model="ir.actions.server">
        <field name="name">Print Invoice</field>
        <field name="model_id" ref="trucking.model_trucking_load"/>
        <field name="binding_model_id" ref="trucking.model_trucking_load"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_consolidated_invoice()</field>
    </record>
</odoo>