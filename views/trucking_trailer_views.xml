<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucking_trailer_tree" model="ir.ui.view">
        <field name="name">trucking.trailer.tree</field>
        <field name="model">trucking.trailer</field>
        <field name="arch" type="xml">
            <list string="Trailers">
                <field name="reg_number"/>
                <field name="make"/>
                <field name="model"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="view_trucking_trailer_form" model="ir.ui.view">
        <field name="name">trucking.trailer.form</field>
        <field name="model">trucking.trailer</field>
        <field name="arch" type="xml">
            <form string="Trailer">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reg_number" placeholder="Registration Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="make"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="partner_id" domain="[('is_supplier', '=', True), ('is_blacklisted_transporter', '=', False)]" context="{'default_is_supplier': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trucking_trailer" model="ir.actions.act_window">
        <field name="name">Trailers</field>
        <field name="res_model">trucking.trailer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item for Trailers -->
    <menuitem id="menu_trucking_trailers" name="Trailers" parent="trucking.menu_trucking_root" action="action_trucking_trailer" sequence="55"/>
</odoo>
