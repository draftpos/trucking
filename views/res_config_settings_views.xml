<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.trucking</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Trucking" string="Trucking" name="trucking">
                    <block title="Default Settings" name="trucking_defaults">
                        <setting help="Set the default Transporter Type for new Loads.">
                            <field name="trucking_default_transporter_type"/>
                        </setting>
                    </block>
                    <block title="Accounting Settings" name="trucking_accounting">
                        <setting help="Default Expense Account for Driver Commission">
                            <field name="driver_commission_account_id"/>
                        </setting>
                        <setting help="Default Cash/Bank Journal for Driver Commission">
                            <field name="driver_commission_journal_id"/>
                        </setting>
                        <setting help="Default Account to receive fuel from clients">
                            <field name="receive_fuel_account_id"/>
                        </setting>
                        <setting help="Default Journal to receive fuel">
                            <field name="receive_fuel_journal_id"/>
                        </setting>
                        <setting help="Auto-create Sales Invoice when Load is Delivered">
                            <field name="trucking_auto_create_invoice"/>
                        </setting>
                        <setting help="Determine when the customer invoice should be generated for External Transporters.">
                            <field name="trucking_customer_invoice_stage" widget="radio" />
                        </setting>
                        <setting help="When should percentage-based driver commissions be calculated?">
                            <field name="trucking_commission_calc_trigger"/>
                        </setting>
                        <setting help="Default Driver Commission Type">
                            <field name="trucking_default_commission_type"/>
                        </setting>
                        <setting help="Default Commission Percentage" invisible="trucking_default_commission_type != 'percentage'">
                            <field name="trucking_default_commission_percentage"/>
                        </setting>
                        <setting help="Default Fixed Commission Amount" invisible="trucking_default_commission_type != 'fixed'">
                            <field name="trucking_default_commission_fixed"/>
                        </setting>
                        <setting help="Default Service Product for Driver Commission (Used on Vendor Bills)">
                            <field name="trucking_default_driver_commission_product_id"/>
                        </setting>
                    </block>
                    
                    <block title="Analytic Settings" name="trucking_analytics">
                        <setting help="How should analytic accounts be tracked for Income and Expenses?">
                            <field name="trucking_analytic_strategy"/>
                        </setting>
                    </block>
                    
                    <block title="Loads Settings" name="trucking_loads">
                        <setting help="Approval Workflow for Fuel and Deposit Advances">
                            <field name="trucking_approval_workflow"/>
                        </setting>
                        <setting help="Allow Non-Expense Deliveries for In-House loads">
                            <field name="trucking_allow_non_expense_deliveries"/>
                        </setting>
                        <setting help="Allow picking a specific Supplier when issuing fuel">
                            <field name="trucking_allow_supplier_on_issue_fuel"/>
                        </setting>
                        <setting help="Allow Zero Value Advance/Fuel Requests">
                            <field name="trucking_allow_zero_advance"/>
                        </setting>
                        <setting help="Activate Issue Fuel Feature">
                            <field name="trucking_enable_issue_fuel"/>
                        </setting>
                        <setting help="Allow adjusting the actual fuel consumed">
                            <field name="trucking_allow_fuel_adjustments"/>
                        </setting>
                        <setting help="Default In-House Fuel Process">
                            <field name="trucking_in_house_fuel_process"/>
                        </setting>
                        <setting help="Default External Fuel Process">
                            <field name="trucking_external_fuel_process"/>
                        </setting>
                        <div class="col-12 mt-4">
                            <span class="d-block font-weight-bold mb-2">Required Fields Configuration</span>
                            <field name="trucking_mandatory_field_ids">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="load_type" readonly="1"/>
                                    <field name="field_id" readonly="1"/>
                                    <field name="is_save" widget="boolean_toggle"/>
                                    <field name="is_confirm" widget="boolean_toggle"/>
                                    <field name="is_deliver" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </div>
                    </block>

                    <block title="General Settings" name="trucking_general">
                        <setting help="Rename 'Proof of Delivery' label">
                            <field name="trucking_pod_label"/>
                        </setting>
                        <setting help="Enable Driver/Transporter Penalties">
                            <field name="trucking_enable_driver_penalties"/>
                        </setting>
                        <setting help="Allow Bulk Invoicing for Unconfirmed PODs">
                            <field name="trucking_allow_unconfirmed_pod_invoice"/>
                        </setting>
                    </block>

                    
                    

                    


                </app>
            </xpath>
        </field>
    </record>

    <record id="action_trucking_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'trucking'}</field>
    </record>
</odoo>
